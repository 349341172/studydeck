# Required for production
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth / Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OpenAI
OPENAI_API_KEY=
# Current low-cost default. You can replace this with another text model available to your API account.
OPENAI_MODEL=gpt-5.6-luna

# Telegram reminders
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional
DATA_FILE=./data/studydeck-db.json
